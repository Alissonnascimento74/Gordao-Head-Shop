# Somente no servidor. Nunca use o prefixo NEXT_PUBLIC_ para este token.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-COLE_SEU_ACCESS_TOKEN_AQUI

# Chave secreta do webhook (Mercado Pago > sua aplicação > Webhooks > "Chave
# secreta"). Usada pra validar a assinatura de cada notificação recebida em
# app/api/webhooks/mercadopago/route.ts. Sem ela: em produção a rota recusa
# toda notificação (fail closed); em dev, ela só pula a validação com um
# aviso no console — não deixe essa variável de fora quando for pra produção.
MERCADOPAGO_WEBHOOK_SECRET=COLE_SUA_CHAVE_SECRETA_DO_WEBHOOK_AQUI

# URL pública final, sem barra no fim. Exemplo: https://minhaloja.com.br
SITE_URL=https://seu-dominio.com.br

# Painel admin (/admin) — login mockado. Sem essas variáveis, usa os padrões
# definidos em lib/admin/auth-config.ts.
ADMIN_USERNAME=Gordãoheadshop
ADMIN_PASSWORD=gordaoheadshop
